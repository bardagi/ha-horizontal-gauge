{
  "name": "horizontal-gauge-card",
  "version": "0.1.0",
  "description": "A responsive horizontal gauge card for Home Assistant",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bardagi/ha-horizontal-gauge.git"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "gauge",
    "custom-card"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/horizontal-gauge-card.js",
    "hacs.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "npm run clean && rollup --config",
    "bundle:check": "node scripts/check-bundle.mjs",
    "build": "npm run bundle && npm run bundle:check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.50.0",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
