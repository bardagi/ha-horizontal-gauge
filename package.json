{
  "name": "horizontal-gauge-card",
  "version": "0.2.0",
  "description": "A responsive horizontal gauge card for Home Assistant",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bardagi/ha-horizontal-gauge.git"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "gauge",
    "custom-card"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/horizontal-gauge-card.js",
    "hacs.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "npm run clean && rollup --config",
    "bundle:check": "node scripts/check-bundle.mjs",
    "build": "npm run bundle && npm run bundle:check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "version": "npm run build && git add dist/horizontal-gauge-card.js"
  },
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
